generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum CaseStatus {
  detecting
  drift_calculating
  ais_scanning
  confirmed
  unresolved
}

model Case {
  id        String     @id // CASE-YYYY-NNN format
  status    CaseStatus @default(detecting)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  /// System 1: Detection output
  /// { polygon: GeoJSON, ageWindowHours: number, confidence: number }
  system1 Json? @db.JsonB

  /// System 2: Drift analysis output
  /// { originRegion: GeoJSON, originTimeWindow: string, driftPath: GeoJSON }
  system2 Json? @db.JsonB

  /// System 3: AIS vessel attribution output
  /// [{ vesselId, name, proximityScore, trajectoryScore, anomalyNotes, confidence }]
  system3 Json? @db.JsonB

  /// Source references and URLs
  /// { sarSceneId, sarSourceUrl, aisSourceId, aisSourceUrl, previewImageUrl }
  sourceRefs Json? @db.JsonB @map("source_refs")

  @@map("cases")
}
